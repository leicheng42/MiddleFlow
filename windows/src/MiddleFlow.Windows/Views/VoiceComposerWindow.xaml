<Window x:Class="MiddleFlow.Windows.Views.VoiceComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiddleFlow 语音"
        Width="640"
        Height="252"
        MinWidth="520"
        MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Focusable="True">
    <Border x:Name="Shell"
            Background="#FFFDFB"
            BorderBrush="#E7DDD3"
            BorderThickness="1"
            CornerRadius="22"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="10"
                              Direction="270"
                              Opacity="0.20"
                              Color="#382B24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="#FFF0E9">
                        <TextBlock Text="&#xE9D9;"
                                   Style="{StaticResource IconTextStyle}"
                                   Foreground="#F26A3D"
                                   FontSize="15" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MiddleFlow 语音"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="豆包输入法 · 右侧 Alt"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Background="#EAF7F0"
                            CornerRadius="12"
                            Padding="9,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#2E9B70"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       Text="正在听写"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#237653" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CloseButton"
                            Content="&#xE711;"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="取消本次语音" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,12,0,10"
                    Background="#F8F4EF"
                    BorderBrush="#E9E1D8"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12">
                <Grid>
                    <TextBlock x:Name="Placeholder"
                               Text="说点什么，转写会实时出现在这里…"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="14"
                               Foreground="#A7A19A"
                               Margin="2,1,0,0"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="Editor"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{StaticResource BodyFont}"
                             FontSize="14"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="#55F26A3D"
                             Padding="0"
                             TextChanged="Editor_TextChanged"
                             PreviewKeyDown="Editor_PreviewKeyDown" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock Text="单击中键完成 · 双击中键完成并发送回车"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="取消"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,0,6,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="CommitButton"
                            Content="完成并粘贴"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CommitButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
