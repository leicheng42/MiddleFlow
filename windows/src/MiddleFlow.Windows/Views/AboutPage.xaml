<UserControl x:Class="MiddleFlow.Windows.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="ABOUT" Style="{StaticResource EyebrowStyle}" />
        <TextBlock Text="MiddleFlow"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,7,0,0" />
        <TextBlock Text="Voice at your fingertip."
                   Style="{StaticResource PageSubtitleStyle}"
                   Margin="0,7,0,0" />

        <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="76" Height="76"
                        CornerRadius="22"
                        Background="{StaticResource AccentBrush}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="White" Margin="0,0,4,0" />
                        <Rectangle Width="4" Height="32" RadiusX="2" RadiusY="2" Fill="White" Margin="0,0,4,0" />
                        <Rectangle Width="4" Height="44" RadiusX="2" RadiusY="2" Fill="White" Margin="0,0,4,0" />
                        <Rectangle Width="4" Height="26" RadiusX="2" RadiusY="2" Fill="White" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MiddleFlow"
                               Style="{StaticResource DisplayTextStyle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersion}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="把鼠标中键变成 macOS / Windows 语音输入入口。"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="隐私优先" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="不录音、不保存转写正文、不上传内容。所有处理都在本机完成。"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="开源项目" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="查看源码、问题反馈和最新版本。"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,8,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="GitHub"
                                Command="{Binding OpenRepositoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="许可证"
                                Command="{Binding OpenLicenseCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SoftCardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="当前平台" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="Windows 10 / 11 · x64 / ARM64 · .NET 8 WPF"
                           Style="{StaticResource CardBodyStyle}"
                           Margin="0,8,0,0" />
                <TextBlock Text="数据目录："
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,10,0,0" />
                <TextBlock Text="{Binding DataDirectory}"
                           Style="{StaticResource MonoFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="恢复默认设置" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="会关闭登录启动并恢复默认手势、浮层和粘贴选项。"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="恢复默认"
                        Command="{Binding ResetSettingsCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
