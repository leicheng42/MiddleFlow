<UserControl x:Class="MiddleFlow.Windows.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="APPS" Style="{StaticResource EyebrowStyle}" />
        <TextBlock Text="告诉 MiddleFlow 哪些应用需要浮层"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,7,0,0" />
        <TextBlock Text="普通应用直接使用豆包输入；画布类应用先把转写收集到浮层，再自动粘贴回原窗口。"
                   Style="{StaticResource PageSubtitleStyle}"
                   MaxWidth="720"
                   Margin="0,8,0,0" />

        <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="画布应用匹配规则" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="进程名或窗口标题包含任意一项时，启用 UU 浮层。"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="10"
                            Padding="9,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <TextBlock Text="支持自定义"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Grid>

                <Border Background="#F8F4EF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,16,0,0">
                    <TextBox Text="{Binding CanvasAppPatterns, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="92"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock Text="用逗号、分号或换行分隔。匹配不区分大小写，会自动忽略 .exe 后缀。"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SoftCardStyle}">
                <StackPanel>
                    <TextBlock Text="默认包含" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="uu.exe · uuclient.exe · uu_remote.exe"
                               Style="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0" />
                    <TextBlock Text="以及“uu remote”“uu远程”窗口标题"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}">
                <StackPanel>
                    <TextBlock Text="如何找到进程名" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="在任务管理器 → 详细信息中查看应用名称；填入不带 .exe 的名称也可以。"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="浮层处理流程" Style="{StaticResource CardTitleStyle}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="01" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="单击中键" Style="{StaticResource CardTitleStyle}" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="浮层获得焦点" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextTertiaryBrush}" Margin="12,20" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="02" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="再单击" Style="{StaticResource CardTitleStyle}" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="文字稳定后粘贴" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="→" Foreground="{StaticResource TextTertiaryBrush}" Margin="12,20" />
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="03" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="双击" Style="{StaticResource CardTitleStyle}" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="粘贴后发送回车" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
