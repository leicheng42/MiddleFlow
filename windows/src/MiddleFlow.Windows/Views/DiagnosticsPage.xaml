<UserControl x:Class="MiddleFlow.Windows.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource EyebrowStyle}" />
        <TextBlock Text="看得见的状态，才容易信任"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,7,0,0" />
        <TextBlock Text="这里只显示事件和状态，不显示转写正文、不记录音频。需要排错时，把日志复制给开发者即可。"
                   Style="{StaticResource PageSubtitleStyle}"
                   MaxWidth="720"
                   Margin="0,8,0,0" />

        <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,12">
                    <StackPanel>
                        <TextBlock Text="最近事件" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{Binding DiagnosticsPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="650"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="刷新"
                                Command="{Binding RefreshLogCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,4,0" />
                        <Button Content="复制"
                                Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1"
                        Background="#171A1F"
                        CornerRadius="0,0,18,18"
                        Padding="16">
                    <TextBox Text="{Binding LogTail, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="#DAD6D0"
                             SelectionBrush="#55F26A3D" />
                </Border>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前状态" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding LastEvent}"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding VoiceModeText}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="  ·  " Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding VoiceStatusText}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="日志操作" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="日志会轮转保存，最多保留最近约 512 KB。"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,10,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开文件"
                                Command="{Binding OpenLogCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="清空"
                                Command="{Binding ClearLogCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SoftCardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="隐私边界" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="日志只包含时间、事件名、输入法状态、字符数量和进程名，不包含转写文字、剪贴板内容或音频数据。"
                           Style="{StaticResource CardBodyStyle}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
