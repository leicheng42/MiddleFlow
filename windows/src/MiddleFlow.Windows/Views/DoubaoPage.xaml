<UserControl x:Class="MiddleFlow.Windows.Views.DoubaoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="INPUT METHOD" Style="{StaticResource EyebrowStyle}" />
        <TextBlock Text="先让豆包准备好"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,7,0,0" />
        <TextBlock Text="MiddleFlow 只负责把中键变成右侧 Alt；语音识别由豆包 Windows 输入法完成。安装并选中它，才能开始说话。"
                   Style="{StaticResource PageSubtitleStyle}"
                   MaxWidth="720"
                   Margin="0,8,0,0" />

        <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DoubaoStateTitle}"
                                   Style="{StaticResource CardTitleStyle}"
                                   FontSize="18"
                                   VerticalAlignment="Center" />
                        <Border CornerRadius="11"
                                Padding="9,4"
                                Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DoubaoReady}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource AmberSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="实时检测"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#237653" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DoubaoReady}" Value="False">
                                                <Setter Property="Foreground" Value="#8B5A16" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DoubaoStateDetail}"
                               Style="{StaticResource CardBodyStyle}"
                               Margin="0,8,0,0"
                               MaxWidth="600" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding DoubaoVersionText}"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="  ·  "
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding DoubaoInstallPathText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MaxWidth="520"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <Button Content="打开豆包官网"
                            Command="{Binding OpenDoubaoDownloadCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right" />
                    <Button Content="重新检测"
                            Command="{Binding RefreshDoubaoCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="四步完成配置" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="只需要做一次。之后 MiddleFlow 会自动识别当前输入法状态。"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,4,0,18" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="1"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="下载并安装豆包 Windows 输入法" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                        <TextBlock Text="打开官网 shurufa.doubao.com/pc，下载 Windows 版豆包输入法。"
                                   Style="{StaticResource CardBodyStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="2"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="把豆包加入 Windows 键盘列表" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                        <TextBlock Text="打开 Windows 设置 → 时间和语言 → 语言和区域 → 键盘，添加豆包输入法。"
                                   Style="{StaticResource CardBodyStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="3"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="确认语音快捷键是右侧 Alt" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                        <TextBlock Text="打开豆包输入法设置，把语音输入设置为长按右侧 Alt。MiddleFlow 会模拟这个按键，不会录制音频。"
                                   Style="{StaticResource CardBodyStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="4"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="回到 MiddleFlow 验证" Style="{StaticResource CardTitleStyle}" FontSize="13" />
                        <TextBlock Text="点击重新检测，确认状态为“已就绪”，再打开测试窗口。"
                                   Style="{StaticResource CardBodyStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource AmberSoftBrush}"
                BorderBrush="#F1D9AE"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           Style="{StaticResource IconTextStyle}"
                           Foreground="{StaticResource AmberBrush}"
                           Margin="0,0,10,0" />
                <TextBlock Text="如果检测状态不是“已就绪”，MiddleFlow 仍然可以映射按键，但豆包不会自动进入语音模式。"
                           Style="{StaticResource CardBodyStyle}"
                           Foreground="#7D5B28"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
