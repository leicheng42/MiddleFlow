<Window x:Class="MiddleFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiddleFlow.Windows.Views"
        xmlns:converters="clr-namespace:MiddleFlow.Windows.Converters"
        Title="MiddleFlow"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:PageVisibilityConverter x:Key="PageVisibility" />
        <Style x:Key="StatNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMappingActive}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#D8D0C8"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38"
                                    CornerRadius="12"
                                    Background="{StaticResource AccentBrush}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Rectangle Width="2.2" Height="9" RadiusX="1" RadiusY="1" Fill="White" Margin="0,0,2,0" />
                                    <Rectangle Width="2.2" Height="16" RadiusX="1" RadiusY="1" Fill="White" Margin="0,0,2,0" />
                                    <Rectangle Width="2.2" Height="22" RadiusX="1" RadiusY="1" Fill="White" Margin="0,0,2,0" />
                                    <Rectangle Width="2.2" Height="13" RadiusX="1" RadiusY="1" Fill="White" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MiddleFlow"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                                <TextBlock Text="Voice at your fingertip"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="8.5"
                                           Foreground="#899099"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Pages}"
                             SelectedValuePath="Key"
                             SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                             Style="{StaticResource NavListBoxStyle}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             Margin="10,16,10,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}"
                                               Style="{StaticResource IconTextStyle}"
                                               FontSize="15"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="20,12,20,20">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDotStyle}" />
                            <TextBlock Text="{Binding MappingStatusText}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#ABB0B8"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="中键 · 语音输入 · Windows"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="9"
                                   Foreground="#6F757E"
                                   Margin="0,9,0,0" />
                        <TextBlock Text="{Binding AppVersion}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="9"
                                   Foreground="#535A64"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FCF9F5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="28,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="31" Height="31"
                                    CornerRadius="9"
                                    Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="{Binding CurrentPageGlyph}"
                                           Style="{StaticResource IconTextStyle}"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="MiddleFlow · Windows edition"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusPillBorderStyle}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDotStyle}" />
                                    <TextBlock Text="{Binding MappingStatusText}"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#237653"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="测试窗口"
                                    Command="{Binding OpenTestWindowCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7"
                                    Margin="0,0,10,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="&#xE713;"
                                    Command="{Binding RefreshDoubaoCommand}"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    ToolTip="检测豆包输入法"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="&#xE921;"
                                    Click="MinimizeButton_Click"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="&#xE922;"
                                    Click="MaximizeButton_Click"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="&#xE8BB;"
                                    Click="CloseButton_Click"
                                    Style="{StaticResource CloseWindowButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <Grid Margin="30,28,30,38" MaxWidth="900" HorizontalAlignment="Left">
                        <views:OverviewPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Overview}" />
                        <views:GesturesPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Gestures}" />
                        <views:VoicePage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Voice}" />
                        <views:DoubaoPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Doubao}" />
                        <views:AppsPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Apps}" />
                        <views:PermissionsPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Permissions}" />
                        <views:DiagnosticsPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Diagnostics}" />
                        <views:AboutPage Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=About}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
